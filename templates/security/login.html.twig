{% extends 'base.html.twig' %}

{% block title %}Login - WorldRecipes | Your Culinary Passport{% endblock %}

{% block navbar %}
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <a href="{{ path('app_home') }}" class="logo">
                <div class="logo-icon">
                    <i class="fas fa-passport"></i>
                </div>
                <span class="logo-text">World<span class="logo-highlight">Recipes</span></span>
            </a>

            <div class="nav-links">
                <a href="{{ path('app_home') }}" class="nav-item"><i class="fas fa-home"></i> Home</a>
                <a href="#" class="nav-item"><i class="fas fa-globe-americas"></i> Explore</a>
                <a href="#" class="nav-item"><i class="fas fa-utensils"></i> Recipes</a>
                <a href="{{ path('app_login') }}" class="nav-item active"><i class="fas fa-sign-in-alt"></i> Login</a>
            </div>

            <div class="nav-actions">
                <a href="{{ path('app_register') }}" class="btn btn-primary">
                    <i class="fas fa-user-plus"></i> Join Free
                </a>
            </div>

            <button class="mobile-menu-btn">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </nav>
{% endblock %}

{% block body %}
    <!-- Login Section -->
    <section class="auth-section">
        <div class="auth-background"></div>
        <div class="auth-container">
            <div class="auth-hero">
                <div class="auth-hero-logo">
                    <div class="auth-hero-icon">
                        <i class="fas fa-passport"></i>
                    </div>
                    <h1 class="auth-hero-title">Welcome to <span class="highlight">WorldRecipes</span></h1>
                </div>

                <h2 class="auth-hero-subtitle">Your Passport to Global Cuisine</h2>
                <p class="auth-hero-description">
                    Sign in to access your culinary passport. Save recipes from 85+ countries,
                    build personalized menus, and track your nutritional journey with our
                    intelligent calorie calculator.
                </p>

                <div class="auth-hero-features">
                    <div class="auth-feature">
                        <div class="auth-feature-icon">
                            <i class="fas fa-globe"></i>
                        </div>
                        <div class="auth-feature-content">
                            <h4>Global Recipe Discovery</h4>
                            <p>Access 1,500+ authentic recipes from around the world</p>
                        </div>
                    </div>

                    <div class="auth-feature">
                        <div class="auth-feature-icon">
                            <i class="fas fa-calculator"></i>
                        </div>
                        <div class="auth-feature-content">
                            <h4>Smart Calorie Tracking</h4>
                            <p>Monitor nutrition with our AI-powered calorie calculator</p>
                        </div>
                    </div>

                    <div class="auth-feature">
                        <div class="auth-feature-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="auth-feature-content">
                            <h4>Personal Menu Planning</h4>
                            <p>Create and save weekly meal plans tailored to your goals</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-card">
                <div class="auth-card-header">
                    <h2 class="auth-card-title">Welcome Back</h2>
                    <p class="auth-card-subtitle">Sign in to continue your culinary journey</p>
                </div>

                {% if success_message %}
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> {{ success_message }}
                    </div>
                {% endif %}

                {% if error %}
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form class="auth-form" action="{{ path('app_login') }}" method="POST">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-group">
                        <label for="email" class="form-label">
                            <i class="fas fa-envelope"></i> Email Address
                        </label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="you@example.com" required value="{{ last_username }}">
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">
                            <i class="fas fa-lock"></i> Password
                        </label>
                        <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
                        <button type="button" class="password-toggle" id="togglePassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" id="remember" name="_remember_me" class="form-check-input">
                        <label for="remember" class="form-check-label">
                            Remember me for 30 days
                        </label>
                        <a href="#" class="ml-auto" style="margin-left: auto; font-size: 0.9rem;">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 1.2rem;">
                        <i class="fas fa-sign-in-alt"></i> Sign In to Your Account
                    </button>
                </form>

                <div class="auth-divider">
                    <span>Or continue with</span>
                </div>

                <div class="social-auth">
                    <button type="button" class="social-auth-btn google">
                        <i class="fab fa-google"></i> Google
                    </button>
                    <button type="button" class="social-auth-btn facebook">
                        <i class="fab fa-facebook-f"></i> Facebook
                    </button>
                </div>

                <div class="auth-switch">
                    <span>New to WorldRecipes?</span>
                    <a href="{{ path('app_register') }}">Create your free account</a>
                </div>

                <div class="auth-form-footer">
                    By continuing, you agree to our
                    <a href="#">Terms of Service</a> and
                    <a href="#">Privacy Policy</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block footer %}
    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-main">
                <div class="footer-col">
                    <div class="footer-logo">
                        <i class="fas fa-passport"></i>
                        World<span class="logo-highlight">Recipes</span>
                    </div>
                    <p class="footer-description">
                        Your passport to global cuisine and smart nutrition. An educational platform for food lovers worldwide.
                    </p>
                    <div class="social-links">
                        <a href="#" class="social-link" aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="social-link" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="social-link" aria-label="Pinterest">
                            <i class="fab fa-pinterest-p"></i>
                        </a>
                        <a href="#" class="social-link" aria-label="YouTube">
                            <i class="fab fa-youtube"></i>
                        </a>
                    </div>
                </div>

                <div class="footer-col">
                    <h4>Explore</h4>
                    <ul class="footer-links">
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Recipe Directory</a></li>
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Cuisine Map</a></li>
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Seasonal Specials</a></li>
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Chef's Corner</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Account</h4>
                    <ul class="footer-links">
                        <li><a href="{{ path('app_login') }}"><i class="fas fa-chevron-right"></i> Sign In</a></li>
                        <li><a href="{{ path('app_register') }}"><i class="fas fa-chevron-right"></i> Create Account</a></li>
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Reset Password</a></li>
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Account Settings</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Legal</h4>
                    <ul class="footer-links">
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Privacy Policy</a></li>
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Terms of Service</a></li>
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Cookie Policy</a></li>
                        <li><a href="#"><i class="fas fa-chevron-right"></i> Contact Us</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-disclaimer">
                <div class="disclaimer-icon">
                    <i class="fas fa-exclamation-circle"></i>
                </div>
                <div class="disclaimer-text">
                    <strong>Educational Purpose:</strong> WorldRecipes is designed for culinary education and nutritional awareness. Calorie values are estimates based on standard nutritional data. This platform does not provide medical advice. For personalized dietary guidance, please consult a healthcare professional.
                </div>
            </div>

            <div class="footer-bottom">
                <p>WorldRecipes © 2024 | Culinary Passport to Global Flavors & Smart Nutrition</p>
                <div class="footer-links-bottom">
                    <a href="#">Privacy Policy</a>
                    <span class="divider">•</span>
                    <a href="#">Terms of Service</a>
                    <span class="divider">•</span>
                    <a href="#">Cookie Policy</a>
                    <span class="divider">•</span>
                    <a href="#">Contact</a>
                </div>
            </div>
        </div>
    </footer>

    {% block javascripts %}
        <script>
            // Password toggle functionality
            document.getElementById('togglePassword').addEventListener('click', function() {
                const passwordInput = document.getElementById('password');
                const icon = this.querySelector('i');

                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    passwordInput.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });
        </script>
    {% endblock %}
{% endblock %}
