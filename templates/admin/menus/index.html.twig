{% extends 'admin/base.html.twig' %}

{% block admin_title %}Manage Menus - Admin{% endblock %}

{% block admin_actions %}
    <a href="{{ path('app_admin_menu_new') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Menu
    </a>
{% endblock %}

{% block admin_content %}
    <div class="admin-section">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Menu</th>
                    <th>User</th>
                    <th>Recipes</th>
                    <th>Total Calories</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for menu in menus %}
                    <tr>
                        <td>{{ menu.id }}</td>
                        <td>
                            <div class="entity-cell">
                                <div class="menu-icon">
                                    <i class="fas fa-clipboard-list"></i>
                                </div>
                                <div>
                                    <strong>{{ menu.name }}</strong>
                                    {% if menu.description %}
                                        <small class="text-muted">{{ menu.description|slice(0, 50) }}...</small>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>{{ menu.user.fullName }}</td>
                        <td>
                            <span class="badge badge-primary">{{ menu.recipes|length }}</span>
                        </td>
                        <td>{{ menu.getTotalCalories()|default('0') }}</td>
                        <td>{{ menu.createdAt|date('Y-m-d') }}</td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_admin_menu_edit', {'id': menu.id}) }}" class="btn-action btn-edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="{{ path('app_admin_menu_delete', {'id': menu.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this menu?')">
                                    <button type="submit" class="btn-action btn-delete" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">No menus found.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <style>
        .menu-icon {
            width: 40px;
            height: 40px;
            background: #f7fafc;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ed8936;
        }
    </style>
{% endblock %}
