{% extends 'admin/base.html.twig' %}

{% block admin_title %}Edit Ingredient - Admin{% endblock %}

{% block admin_actions %}
    <a href="{{ path('app_admin_ingredients') }}" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
{% endblock %}

{% block admin_content %}
    <div class="admin-section">
        {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-row">
            <div class="form-group">
                {{ form_label(form.caloriesPerUnit) }}
                {{ form_widget(form.caloriesPerUnit) }}
                {{ form_errors(form.caloriesPerUnit) }}
            </div>

            <div class="form-group">
                {{ form_label(form.unit) }}
                {{ form_widget(form.unit) }}
                {{ form_errors(form.unit) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="form-actions">
            {{ form_widget(form.save) }}
            <a href="{{ path('app_admin_ingredients') }}" class="btn btn-outline">
                Cancel
            </a>
        </div>
        {{ form_end(form) }}
    </div>

    <style>
        /* Keep the same styling as before */
        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }
    </style>
{% endblock %}
