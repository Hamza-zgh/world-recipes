{% extends 'admin/base.html.twig' %}

{% block admin_title %}Manage Ingredients - Admin{% endblock %}

{% block admin_actions %}
    <a href="{{ path('app_admin_ingredient_new') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Ingredient
    </a>
{% endblock %}

{% block admin_content %}
    <div class="admin-section">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Ingredient</th>
                    <th>Calories/Unit</th>
                    <th>Unit</th>
                    <th>Recipes</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for ingredient in ingredients %}
                    <tr>
                        <td>{{ ingredient.id }}</td>
                        <td>
                            <div class="entity-cell">
                                <div class="ingredient-icon">
                                    <i class="fas fa-carrot"></i>
                                </div>
                                <div>
                                    <strong>{{ ingredient.name }}</strong>
                                    {% if ingredient.description %}
                                        <small class="text-muted">{{ ingredient.description|slice(0, 50) }}...</small>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>{{ ingredient.caloriesPerUnit }}</td>
                        <td>
                            <span class="unit-badge">{{ ingredient.unit }}</span>
                        </td>
                        <td>
                            <span class="badge badge-primary">{{ ingredient.recipeIngredients|length }}</span>
                        </td>
                        <td>{{ ingredient.createdAt|date('Y-m-d') }}</td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_admin_ingredient_edit', {'id': ingredient.id}) }}" class="btn-action btn-edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="{{ path('app_admin_ingredient_delete', {'id': ingredient.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this ingredient?')">
                                    <button type="submit" class="btn-action btn-delete" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">No ingredients found.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <style>
        .ingredient-icon {
            width: 40px;
            height: 40px;
            background: #f7fafc;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #48bb78;
        }

        .unit-badge {
            display: inline-block;
            padding: 4px 8px;
            background: #e2e8f0;
            color: #4a5568;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: 500;
        }
    </style>
{% endblock %}
