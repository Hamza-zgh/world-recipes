{% extends 'admin/base.html.twig' %}

{% block admin_title %}Manage Recipes - Admin{% endblock %}

{% block admin_actions %}
    <a href="{{ path('app_admin_recipe_new') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Recipe
    </a>
{% endblock %}

{% block admin_content %}
    <div class="admin-section">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Recipe</th>
                    <th>Country</th>
                    <th>User</th>
                    <th>Difficulty</th>
                    <th>Calories</th>
                    <th>Time</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for recipe in recipes %}
                    <tr>
                        <td>{{ recipe.id }}</td>
                        <td>
                            <div class="entity-cell">
                                {% if recipe.image %}
                                    <div class="recipe-img-container">
                                        <img src="{{ asset('uploads/recipes/' ~ recipe.image) }}" alt="{{ recipe.title }}" class="recipe-img-sm"
                                             onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-utensils\'></i>';">
                                    </div>
                                {% else %}
                                    <div class="recipe-icon">
                                        <i class="fas fa-utensils"></i>
                                    </div>
                                {% endif %}
                                <div>
                                    <strong>{{ recipe.title }}</strong>
                                    {% if recipe.description %}
                                        <small class="text-muted">{{ recipe.description|slice(0, 50) }}...</small>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>{{ recipe.country.name }}</td>
                        <td>{{ recipe.user.fullName }}</td>
                        <td>
                            <span class="difficulty-badge difficulty-{{ recipe.difficulty|lower|default('unknown') }}">
                                {{ recipe.difficulty|default('N/A') }}
                            </span>
                        </td>
                        <td>{{ recipe.totalCalories|default('0') }}</td>
                        <td>{{ (recipe.preparationTime|default(0) + recipe.cookingTime|default(0)) }} min</td>
                        <td>{{ recipe.createdAt|date('Y-m-d') }}</td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="btn-action btn-view" title="View" target="_blank">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_admin_recipe_edit', {'id': recipe.id}) }}" class="btn-action btn-edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="{{ path('app_admin_recipe_delete', {'id': recipe.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this recipe?')">
                                    <button type="submit" class="btn-action btn-delete" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center">No recipes found.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <style>
        .recipe-img-container {
            width: 40px;
            height: 40px;
            border-radius: 5px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f7fafc;
        }

        .recipe-img-sm {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .recipe-icon {
            width: 40px;
            height: 40px;
            background: #f7fafc;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4299e1;
            font-size: 1.2rem;
        }

        .difficulty-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 500;
            text-transform: capitalize;
        }

        .difficulty-easy {
            background: #c6f6d5;
            color: #22543d;
        }

        .difficulty-medium {
            background: #fed7d7;
            color: #c53030;
        }

        .difficulty-hard {
            background: #e9d8fd;
            color: #553c9a;
        }

        .difficulty-unknown {
            background: #e2e8f0;
            color: #4a5568;
        }

        .entity-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .entity-cell > div {
            flex: 1;
        }

        .action-buttons {
            display: flex;
            gap: 5px;
        }

        .btn-action {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
        }

        .btn-view {
            background: #c6f6d5;
            color: #22543d;
        }

        .btn-view:hover {
            background: #9ae6b4;
        }

        .btn-edit {
            background: #bee3f8;
            color: #2c5282;
        }

        .btn-edit:hover {
            background: #90cdf4;
        }

        .btn-delete {
            background: #fed7d7;
            color: #c53030;
        }

        .btn-delete:hover {
            background: #feb2b2;
        }

        .text-muted {
            color: #718096;
            font-size: 0.85rem;
            display: block;
            margin-top: 2px;
        }
    </style>
{% endblock %}
