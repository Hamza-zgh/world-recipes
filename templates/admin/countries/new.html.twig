{% extends 'admin/base.html.twig' %}

{% block admin_title %}Add New Country - Admin{% endblock %}

{% block admin_actions %}
    <a href="{{ path('app_admin_countries') }}" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
{% endblock %}

{% block admin_content %}
    <div class="admin-section">
        <form method="POST" class="admin-form" enctype="multipart/form-data">
            <div class="form-group">
                <label for="name">Country Name *</label>
                <input type="text" id="name" name="name" class="form-control" required>
            </div>

            <div class="form-group">
                <label for="region">Region</label>
                <input type="text" id="region" name="region" class="form-control"
                       placeholder="e.g., Europe, Asia, Africa">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="flag">Flag Image</label>
                    <input type="file" id="flag" name="flag" class="form-control-file" accept="image/*">
                    <small class="text-muted">Recommended: 4:3 ratio, max 1MB</small>
                </div>

                <div class="form-group">
                    <label for="cuisineImage">Cuisine Image</label>
                    <input type="file" id="cuisineImage" name="cuisineImage" class="form-control-file" accept="image/*">
                    <small class="text-muted">Recommended: 16:9 ratio, max 2MB</small>
                </div>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" class="form-control" rows="4"
                          placeholder="Describe the country's cuisine..."></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Create Country
                </button>
                <a href="{{ path('app_admin_countries') }}" class="btn btn-outline">
                    Cancel
                </a>
            </div>
        </form>
    </div>
{% endblock %}
