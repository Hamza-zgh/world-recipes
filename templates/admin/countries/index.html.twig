{% extends 'admin/base.html.twig' %}

{% block admin_title %}Manage Countries - Admin{% endblock %}

{% block admin_actions %}
    <a href="{{ path('app_admin_country_new') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Country
    </a>
{% endblock %}

{% block admin_content %}
    <div class="admin-section">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Country</th>
                    <th>Region</th>
                    <th>Flag</th>
                    <th>Recipes</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for country in countries %}
                    <tr>
                        <td>{{ country.id }}</td>
                        <td>
                            <div class="entity-cell">
                                {% if country.cuisineImage %}
                                    <div class="country-img-container">
                                        <img src="{{ asset('uploads/countries/' ~ country.cuisineImage) }}" alt="{{ country.name }}" class="country-img-sm"
                                             onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-globe\'></i>';">
                                    </div>
                                {% else %}
                                    <div class="country-icon">
                                        <i class="fas fa-globe"></i>
                                    </div>
                                {% endif %}
                                <div>
                                    <strong>{{ country.name }}</strong>
                                    {% if country.description %}
                                        <small class="text-muted">{{ country.description|slice(0, 50) }}...</small>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>{{ country.region|default('N/A') }}</td>
                        <td>
                            {% if country.flag %}
                                <img src="{{ asset('uploads/flags/' ~ country.flag) }}" alt="{{ country.name }} flag" class="flag-img"
                                     onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-flag\'></i>';">
                            {% else %}
                                <span class="text-muted">No flag</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge badge-primary">{{ country.recipes|length }}</span>
                        </td>
                        <td>{{ country.createdAt|date('Y-m-d') }}</td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_admin_country_edit', {'id': country.id}) }}" class="btn-action btn-edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="{{ path('app_admin_country_delete', {'id': country.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this country?')">
                                    <button type="submit" class="btn-action btn-delete" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">No countries found.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <style>
        .country-img-container {
            width: 40px;
            height: 40px;
            border-radius: 5px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f7fafc;
        }

        .country-img-sm {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .country-icon {
            width: 40px;
            height: 40px;
            background: #f7fafc;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4299e1;
            font-size: 1.2rem;
        }

        .flag-img {
            width: 30px;
            height: 20px;
            border-radius: 3px;
            object-fit: cover;
            border: 1px solid #e2e8f0;
        }
    </style>
{% endblock %}
