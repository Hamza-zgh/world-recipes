{% extends 'admin/base.html.twig' %}

{% block admin_title %}Manage Users - Admin{% endblock %}

{% block admin_actions %}
    <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add User
    </a>
{% endblock %}

{% block admin_content %}
    <div class="admin-section">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Recipes</th>
                    <th>Menus</th>
                    <th>Joined</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>
                            <div class="entity-cell">
                                <div class="user-avatar-sm">
                                    {% if user.profileImage %}
                                        <img src="{{ asset('uploads/profile/' ~ user.profileImage) }}" alt="{{ user.fullName }}">
                                    {% else %}
                                        {{ user.fullName|first|upper }}
                                    {% endif %}
                                </div>
                                <div>
                                    <strong>{{ user.fullName }}</strong>
                                    {% if user == app.user %}
                                        <span class="badge badge-you">You</span>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>{{ user.email }}</td>
                        <td>
                            <span class="role-badge {{ user.role == 'ROLE_ADMIN' ? 'role-admin' : 'role-user' }}">
                                {{ user.role == 'ROLE_ADMIN' ? 'Admin' : 'User' }}
                            </span>
                        </td>
                        <td>
                            <span class="badge badge-primary">{{ user.recipes|length }}</span>
                        </td>
                        <td>
                            <span class="badge badge-primary">{{ user.menus|length }}</span>
                        </td>
                        <td>{{ user.createdAt|date('Y-m-d') }}</td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn-action btn-edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                {% if user != app.user %}
                                    <form action="{{ path('app_admin_user_delete', {'id': user.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?')">
                                        <button type="submit" class="btn-action btn-delete" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center">No users found.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <style>
        .user-avatar-sm {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #4299e1;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            overflow: hidden;
        }

        .user-avatar-sm img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .badge-primary {
            background: #4299e1;
            color: white;
        }

        .badge-you {
            background: #e2e8f0;
            color: #4a5568;
            margin-top: 2px;
        }

        .role-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .role-admin {
            background: #fed7d7;
            color: #c53030;
        }

        .role-user {
            background: #c6f6d5;
            color: #22543d;
        }

        .entity-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .text-center {
            text-align: center;
            color: #718096;
            padding: 40px !important;
        }
    </style>
{% endblock %}
