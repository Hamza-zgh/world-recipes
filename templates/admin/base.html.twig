{% extends 'base.html.twig' %}

{% block title %}{% block admin_title %}Admin - WorldRecipes{% endblock %}{% endblock %}

{% block navbar %}
    {% include 'includes/navbar.html.twig' %}
{% endblock %}

{% block body %}
    <div class="admin-container">
        <div class="admin-sidebar">
            <div class="sidebar-header">
                <h3><i class="fas fa-crown"></i> Admin Panel</h3>
            </div>
            <nav class="sidebar-nav">
                <a href="{{ path('app_admin_dashboard') }}" class="sidebar-item {{ app.request.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
                <a href="{{ path('app_admin_users') }}" class="sidebar-item {{ app.request.get('_route') starts with 'app_admin_user' ? 'active' : '' }}">
                    <i class="fas fa-users"></i> Users
                </a>
                <a href="{{ path('app_admin_countries') }}" class="sidebar-item {{ app.request.get('_route') starts with 'app_admin_countr' ? 'active' : '' }}">
                    <i class="fas fa-globe"></i> Countries
                </a>
                <a href="{{ path('app_admin_recipes') }}" class="sidebar-item {{ app.request.get('_route') starts with 'app_admin_recipe' ? 'active' : '' }}">
                    <i class="fas fa-utensils"></i> Recipes
                </a>
                <a href="{{ path('app_admin_ingredients') }}" class="sidebar-item {{ app.request.get('_route') starts with 'app_admin_ingredient' ? 'active' : '' }}">
                    <i class="fas fa-carrot"></i> Ingredients
                </a>
                <a href="{{ path('app_admin_menus') }}" class="sidebar-item {{ app.request.get('_route') starts with 'app_admin_menu' ? 'active' : '' }}">
                    <i class="fas fa-clipboard-list"></i> Menus
                </a>
            </nav>
        </div>

        <div class="admin-content">
            <div class="admin-header">
                <h1 class="admin-title">{% block admin_content_title %}Admin{% endblock %}</h1>
                <div class="admin-actions">
                    {% block admin_actions %}{% endblock %}
                </div>
            </div>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> {{ message }}
                </div>
            {% endfor %}

            {% block admin_content %}{% endblock %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .admin-container {
            display: flex;
            min-height: calc(100vh - 70px);
        }

        .admin-sidebar {
            width: 250px;
            background: #1a202c;
            color: white;
            padding: 20px 0;
        }

        .sidebar-header {
            padding: 0 20px 20px;
            border-bottom: 1px solid #2d3748;
        }

        .sidebar-header h3 {
            margin: 0;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-nav {
            padding: 20px 0;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            color: #cbd5e0;
            text-decoration: none;
            transition: all 0.3s;
        }

        .sidebar-item:hover {
            background: #2d3748;
            color: white;
        }

        .sidebar-item.active {
            background: #4299e1;
            color: white;
        }

        .sidebar-item i {
            width: 24px;
            margin-right: 10px;
        }

        .admin-content {
            flex: 1;
            padding: 30px;
            background: #f7fafc;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #e2e8f0;
        }

        .admin-title {
            font-size: 1.8rem;
            color: #2d3748;
            margin: 0;
        }

        .admin-actions .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .alert {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-success {
            background: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }

        .alert-danger {
            background: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
        }

        @media (max-width: 768px) {
            .admin-container {
                flex-direction: column;
            }

            .admin-sidebar {
                width: 100%;
                padding: 15px 0;
            }

            .sidebar-nav {
                display: flex;
                overflow-x: auto;
                padding: 0 15px;
            }

            .sidebar-item {
                white-space: nowrap;
            }
        }
    </style>
{% endblock %}
